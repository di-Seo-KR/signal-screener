//@version=6
// ════════════════════════════════════════════════════════════════════
// Zepta Timing Fusion v3 — 총동원 종합 점수 타점 (나만의 인디케이터)
// ────────────────────────────────────────────────────────────────────
// Zepta 퀀트 엔진(api/_shared/timing-signals.js v3)과 동일 로직 Pine 포팅.
//
// 만든 방법 (2026-07-04): 지표·봉패턴·차트패턴 19종 총동원 → 후보 114조합
// (19요소×3TF×롱숏)을 바이낸스 USDM 24심볼 실측으로 선별(두 구간 부호일관 +
// OOS≥수수료 + 클러스터-강건 t≥1.5, 신규요소는 두 구간 각각 t≥1.0 추가).
// → 17조합 생존(전부 롱). 홀드아웃 6심볼 최종: 1h +42bps(t1.8)·4h +71bps(t2.6).
// 합류 점수↑ = 엣지↑ 실측: 1h 2.5점↑ +51bps · 3.0점↑ +68bps (단조 증가).
//
// TF별 검증 요소:
//   1h (7): 상승장악·눌림목·저항돌파·HL구조·스토캐스틱반등·OBV매집·돌파리테스트
//   4h (9): 관통형·RSI반등·스윕리클레임·저항돌파·MACD골든크로스·MACD모멘텀반전·
//           스토캐스틱반등·OBV매집·돌파리테스트
//   일봉+(1): 적삼병
// 발화선: 점수 1.9(47/100) · 강한 합류: 2.5(63/100 — 실측 엣지 2배↑ 티어)
//
// ★ 숏 정직 고지: 반전형·지속형·레짐조건부 포함 숏 ~40조합이 3차례 검증에서
//   전멸 — 크립토 차트 TA 숏 타점은 일관 엣지가 없습니다. 검증 신호는 롱 전용,
//   "숏 실험 표시"는 미검증 참고용(주황)입니다.
//
// 사용법: Pine 편집기 → 붙여넣기 → 차트에 추가. 권장: BINANCE:BTCUSDT.P 등
//   바이낸스 무기한 × 1h/4h/일봉. 알림: ⏰ → "Zepta 강한 합류 롱" → 봉 마감 시 1회.
// 정직 고지: 과거 실측 기반 참고 신호이며 수익을 보장하지 않습니다.
// ════════════════════════════════════════════════════════════════════
indicator("Zepta Timing Fusion v3 — 총동원 종합 점수", shorttitle="Zepta 타점 v3", overlay=true)

grpMode = "모드"
confirmedOnly = input.bool(true, "확정봉만 표시 (리페인트 방지)", group=grpMode)
showResearchShort = input.bool(false, "숏 실험 표시 (⚠ 미검증 — 실측 엣지 없음)", group=grpMode)
grpGate = "게이트 (엔진 기본값)"
srAtrMult = input.float(1.5, "S/R 근접 허용 (×ATR)", minval=0.5, maxval=3.0, step=0.1, group=grpGate)
pivotLen  = input.int(2, "피벗 강도", minval=2, maxval=5, group=grpGate)
showTable = input.bool(true, "상태 패널", group=grpGate)

// ── TF ─────────────────────────────────────────────────────────────
tfMinutes = timeframe.in_seconds() / 60.0
isTfDaily = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
tfKey = isTfDaily ? "1d" : tfMinutes == 240.0 ? "4h" : tfMinutes == 60.0 ? "1h" : "off"
tfValid = tfKey != "off"

// ── 지표 (엔진과 동일 정의) ─────────────────────────────────────────
atr    = ta.sma(ta.tr(true), 14)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
rsi    = ta.rsi(close, 14)
volSma = ta.sma(volume, 20)
hasVol = not na(volume) and volume > 0
[macdLine, macdSig, macdHist] = ta.macd(close, 12, 26, 9)
stochK = ta.stoch(close, high, low, 14)
stochD = ta.sma(stochK, 3)
obvV   = ta.obv
obvE   = ta.ema(obvV, 20)

body  = math.abs(close - open)
rng   = high - low
body1 = math.abs(close[1] - open[1])
body2 = math.abs(close[2] - open[2])
loW   = math.min(open, close) - low
isBull = close > open
closePos  = rng > 0 ? (close - low) / rng : 0.0
rng1 = high[1] - low[1]
rng2 = high[2] - low[2]
closePos1 = rng1 > 0 ? (close[1] - low[1]) / rng1 : 0.0
closePos2 = rng2 > 0 ? (close[2] - low[2]) / rng2 : 0.0

// ── S/R 피벗 클러스터 (0.5ATR 클러스터·터치≥2·120봉) ────────────────
var array<float> pivots   = array.new<float>()
var array<int>   pivotBar = array.new<int>()
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
if not na(ph)
    array.push(pivots, ph)
    array.push(pivotBar, bar_index - pivotLen)
if not na(pl)
    array.push(pivots, pl)
    array.push(pivotBar, bar_index - pivotLen)
while array.size(pivotBar) > 0 and bar_index - array.get(pivotBar, 0) > 120
    array.shift(pivots)
    array.shift(pivotBar)

f_srFlags() =>
    sweepUp = false
    breakUp = false
    breakLvl = float(na)
    nearSup = false
    n = array.size(pivots)
    if n > 0 and atr > 0
        for i = 0 to n - 1
            p = array.get(pivots, i)
            touches = 0
            for j = 0 to n - 1
                if math.abs(array.get(pivots, j) - p) <= 0.5 * atr
                    touches += 1
            if touches >= 2
                if math.abs(close - p) <= srAtrMult * atr and p <= close + 0.25 * atr
                    nearSup := true
                if low < p - 0.05 * atr and close > p + 0.05 * atr and loW >= 0.7 * atr and isBull
                    sweepUp := true
                if close > p + 0.25 * atr and close[1] <= p + 0.05 * atr
                    breakUp := true
                    breakLvl := p
    [sweepUp, breakUp, breakLvl, nearSup]
[sweepUp, breakUp, breakLvl, nearSup] = f_srFlags()

// 스윙 구조 (확정 피벗 저점 2개 → HL, 신선도 3봉)
var float lastPL = na
var float prevPL = na
if not na(pl)
    prevPL := lastPL
    lastPL := pl
structHL = not na(prevPL) and not na(lastPL) and lastPL > prevPL + 0.1 * atr and ta.barssince(not na(pl)) <= 3 and close > ema20
var float lastPH = na
var float prevPH = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
structLH = not na(prevPH) and not na(lastPH) and lastPH < prevPH - 0.1 * atr and ta.barssince(not na(ph)) <= 3 and close < ema20

// 돌파 리테스트 추적
var float retestLvl = na
var int   retestBar = na
structBreakL = ema20 > ema50 and isBull and body >= 0.5 * atr and breakUp
if structBreakL
    retestLvl := breakLvl
    retestBar := bar_index
breakRetestL = not na(retestLvl) and not na(retestBar) and bar_index - retestBar >= 1 and bar_index - retestBar <= 6 and low <= retestLvl + 0.3 * atr and close > retestLvl and isBull

// ── 검증 요소 (17조합 — 엔진 VALIDATED_TIMING 동일) ─────────────────
downLeg = close < ema20 or close < close[10]
upLeg   = close > ema20 or close > close[10]
volConfirm = hasVol and volSma > 0 and volume >= 1.5 * volSma

patBullEngulf = close[1] < open[1] and isBull and body >= 1.2 * body1 and body >= 0.5 * atr and body1 >= 0.05 * atr and close >= math.max(open[1], close[1]) and open <= math.min(open[1], close[1]) + 0.1 * atr and downLeg and nearSup
patPiercing   = close[1] < open[1] and body1 >= 0.5 * atr and isBull and open <= close[1] + 0.1 * atr and close > (open[1] + close[1]) / 2 and close < open[1] and downLeg and nearSup
patSoldiers   = close[2] > open[2] and close[1] > open[1] and isBull and body2 >= 0.5 * atr and body1 >= 0.5 * atr and body >= 0.5 * atr and close[1] > close[2] and close > close[1] and closePos >= 0.6 and closePos1 >= 0.6 and closePos2 >= 0.6 and (close - open[2]) <= 3.2 * atr and upLeg
pullbackL   = ema20 > ema50 and low <= ema20 + 0.3 * atr and close > ema20 and isBull and close > close[1]
rsiRevL     = rsi[1] < 30 and rsi >= 30 and rsi < 45
macdCrossL  = macdLine > macdSig and macdLine[1] <= macdSig[1]
macdTurnL   = macdHist > macdHist[1] and macdHist[1] <= macdHist[2] and macdHist[1] < 0
stochCrossL = stochK > stochD and stochK[1] <= stochD[1] and stochK[1] < 25
obvAccumL   = hasVol and obvV > obvE and obvV > obvV[5] and close <= close[5]

// ── 종합 점수 (가중 = 엔진과 동일) ──────────────────────────────────
score1h = (patBullEngulf ? 0.525 : 0) + (pullbackL ? 1.0 : 0) + (structBreakL ? 1.0 : 0) + (structHL ? 1.0 : 0) + (stochCrossL ? 0.8 : 0) + (obvAccumL ? 0.9 : 0) + (breakRetestL ? 1.1 : 0)
score4h = (patPiercing ? 1.0125 : 0) + (rsiRevL ? 0.8 : 0) + (sweepUp ? 1.2 : 0) + (structBreakL ? 1.0 : 0) + (macdCrossL ? 0.9 : 0) + (macdTurnL ? 0.8 : 0) + (stochCrossL ? 0.8 : 0) + (obvAccumL ? 0.9 : 0) + (breakRetestL ? 1.1 : 0)
score1d = patSoldiers ? 0.9 : 0
rawScore = tfKey == "1h" ? score1h : tfKey == "4h" ? score4h : tfKey == "1d" ? score1d : 0.0
volBonus = volConfirm and rawScore > 0 and isBull ? 0.5 : 0.0
longScore = rawScore + volBonus
scorePct = math.min(100, math.round(longScore / 4.0 * 100))
thTf = tfKey == "1d" ? 0.75 : 1.9

barOk = confirmedOnly ? barstate.isconfirmed : true
// 쿨다운: 강추세 클러스터 억제 — 직전 신호 후 N봉 내엔 점수 에스컬레이션 시에만 재발화
cdBars = tfKey == "1h" ? 6 : tfKey == "4h" ? 4 : 2
var int   lastSigBar = na
var float lastSigScore = 0.0
longSignalRaw = tfValid and longScore >= thTf and barOk
canFire = na(lastSigBar) or bar_index - lastSigBar > cdBars or longScore > lastSigScore + 0.5
longSignal = longSignalRaw and canFire
var int exitUntil = na
if longSignal
    lastSigBar := bar_index
    lastSigScore := longScore
    exitUntil := bar_index + 60
strongSignal = longSignal and longScore >= 3.0 // "롱유리" 75점+ (대표 지정 티어)
// 청산 규칙: 롱 신호 후 EMA20 종가 하향 이탈 — 리스크 규칙(예측 아님).
//   실측: 평균수익 소폭 희생 대신 최악 5% 손실 절반 이하(1h −652→−267bps).
exitSignal = not na(exitUntil) and bar_index > lastSigBar and bar_index <= exitUntil and close < ema20 and close[1] >= ema20[1] and barOk
if exitSignal
    exitUntil := na
shortResearch = showResearchShort and tfValid and barOk and structLH and ema20 < ema50 and close < open and close < close[1]

// ── 표시 ───────────────────────────────────────────────────────────
plotshape(strongSignal, title="롱유리(75점+)", style=shape.triangleup, location=location.belowbar, color=color.new(#16A34A, 0), size=size.small, text="롱유리", textcolor=color.new(#16A34A, 0))
plotshape(longSignal and not strongSignal, title="검증 롱 타점(47점+)", style=shape.triangleup, location=location.belowbar, color=color.new(#22C55E, 25), size=size.tiny)
plotshape(exitSignal, title="청산 (EMA20 이탈 규칙)", style=shape.square, location=location.abovebar, color=color.new(#F59E0B, 0), size=size.tiny, text="청산", textcolor=color.new(#F59E0B, 0))
plotshape(shortResearch, title="숏 (미검증 실험)", style=shape.triangledown, location=location.abovebar, color=color.new(#F59E0B, 40), size=size.tiny, text="실험", textcolor=color.new(#F59E0B, 40))

// ── 상태 패널 (종합 점수 게이지) ────────────────────────────────────
var table panel = table.new(position.top_right, 1, 4, bgcolor=color.new(#0A0B0F, 15), border_width=1, border_color=color.new(#23262F, 0))
if showTable and barstate.islast
    tfTxt = tfKey == "1d" ? "일봉+ · 검증 1요소" : tfKey == "4h" ? "4시간 · 검증 9요소" : tfKey == "1h" ? "1시간 · 검증 7요소 · 쿨다운 6봉" : "⚠ 미지원 TF (1h/4h/일봉+만 — 신호 없음)"
    lastPct = math.min(100, math.round(lastSigScore / 4.0 * 100))
    recentTxt = not na(lastSigBar) and bar_index - lastSigBar <= 24 ? " · 최근 " + str.tostring(lastPct) + "점(" + str.tostring(bar_index - lastSigBar) + "봉 전)" : ""
    scoreTxt = tfValid ? "현재 종합: 롱 " + str.tostring(scorePct) + "/100 (발화 " + str.tostring(math.round(thTf / 4.0 * 100)) + " · 롱유리 75)" + recentTxt : "—"
    table.cell(panel, 0, 0, "Zepta Timing Fusion v3.2", text_color=color.new(#F4F5F7, 0), text_size=size.small)
    table.cell(panel, 0, 1, tfTxt, text_color=tfValid ? color.new(#A1A6B2, 0) : color.new(#FFB020, 0), text_size=size.small)
    table.cell(panel, 0, 2, scoreTxt, text_color=scorePct >= 75 ? color.new(#16A34A, 0) : scorePct >= 47 ? color.new(#22C55E, 0) : color.new(#A1A6B2, 0), text_size=size.small)
    table.cell(panel, 0, 3, "총동원 19종→검증 17조합만 점수화 · 숏 전 가설 탈락 · 수익 보장 아님", text_color=color.new(#6E7585, 0), text_size=size.tiny)

// ── 알림 ───────────────────────────────────────────────────────────
alertcondition(longSignal,   title="Zepta 롱 타점(47점+)", message="Zepta v3.2: {{ticker}} {{interval}} 검증 롱(▲)")
alertcondition(strongSignal, title="Zepta 롱유리(75점+)",  message="Zepta v3.2: {{ticker}} {{interval}} 롱유리(▲) — 실측 상위 티어")
alertcondition(exitSignal,   title="Zepta 청산 신호",      message="Zepta v3.2: {{ticker}} {{interval}} 청산(■) — EMA20 이탈 리스크 규칙")
