{
  "rewrites": [
    { "source": "/api/yahoo-ohlc", "destination": "/api/yahoo?_mode=ohlc" },
    { "source": "/api/yahoo-batch", "destination": "/api/yahoo?_mode=batch" },
    { "source": "/api/yahoo-quote", "destination": "/api/yahoo?_mode=quote" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/btc-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/quant-research",
      "schedule": "0 6 * * *"
    }
  ]
}
